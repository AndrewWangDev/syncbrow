<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <include domain="file" path="."/>
    <include domain="database" path="."/>
    <!-- Exclude sensitive database containing credentials from backup extraction -->
    <exclude domain="database" path="scanner_database"/>
    <exclude domain="database" path="scanner_database-wal"/>
    <exclude domain="database" path="scanner_database-shm"/>
    <!-- Exclude sensitive DataStore preferences containing password hashes and salts -->
    <exclude domain="file" path="datastore"/>
</full-backup-content>
