<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <include domain="database" path="."/>
        <!-- Exclude sensitive database containing credentials from cloud backup -->
        <exclude domain="database" path="scanner_database"/>
        <exclude domain="database" path="scanner_database-wal"/>
        <exclude domain="database" path="scanner_database-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <include domain="database" path="."/>
        <!-- Exclude sensitive database containing credentials from device transfer -->
        <exclude domain="database" path="scanner_database"/>
        <exclude domain="database" path="scanner_database-wal"/>
        <exclude domain="database" path="scanner_database-shm"/>
    </device-transfer>
</data-extraction-rules>
